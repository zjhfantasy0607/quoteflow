NODE_ENV=development
API_PORT=3000
# 监听地址；容器里设为 0.0.0.0
API_HOST=127.0.0.1
# 可信的上游代理（Express trust proxy）；容器里 nginx 在私有网段，设为 uniquelocal
TRUST_PROXY=loopback
# 邮件中的链接前缀
APP_BASE_URL=http://127.0.0.1:5173

DATABASE_URL=postgresql://quoteflow:quoteflow_dev@127.0.0.1:15432/quoteflow?schema=public
DATABASE_URL_TEST=postgresql://quoteflow:quoteflow_dev@127.0.0.1:15432/quoteflow_test?schema=public

SESSION_COOKIE_NAME=qf_sid
COOKIE_SECURE=false

STORAGE_DRIVER=local
STORAGE_DIR=./storage

# smtp | log
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QuoteFlow <noreply@quoteflow.local>"

# 锁定报价 Excel 的签名密钥与工作表保护密码（生产必须改）
EXCEL_SIGNING_SECRET=dev-only-change-me
EXCEL_SHEET_PASSWORD=quoteflow

JOBS_ENABLED=true
LOG_LEVEL=debug
PRISMA_HIDE_UPDATE_MESSAGE=true
