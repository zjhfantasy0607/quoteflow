# QuoteFlow API 的配置（不使用 Docker 时，docs/交付/部署手册-不使用Docker.md §5）。
# 位置 /etc/quoteflow/quoteflow.env，属主 root:quoteflow、权限 640（install.sh 首次运行时从本模板生成）。
# 格式同 systemd 的 EnvironmentFile：每行 KEY=值；值里有空格时整体加双引号；值里不要用 $、反引号和双引号。
# 标了 CHANGE_ME 的都要改，改完 install.sh 才会继续；密钥可以用 openssl rand -hex 24 生成。

NODE_ENV=production
# API 只监听本机，由同一台机器上的 nginx 反代
API_HOST=127.0.0.1
API_PORT=3000
# 信任本机 nginx 转发的客户端 IP（登录限流、操作日志按真实 IP 记录）
TRUST_PROXY=loopback

# 用户访问系统的地址：邮件里的链接以它开头
APP_BASE_URL=https://quote.example.com

# 数据库：库和用户按部署手册 §4.2 创建；密码只用字母和数字（避免 URL 转义）
DATABASE_URL=postgresql://quoteflow:CHANGE_ME@127.0.0.1:5432/quoteflow?schema=public

SESSION_COOKIE_NAME=qf_sid
# 只有通过 HTTPS 访问时才能为 true；内网只用 HTTP 试用时改成 false，否则浏览器不回传会话 cookie、无法登录
COOKIE_SECURE=true

STORAGE_DRIVER=local
# 上传文件目录，属主 quoteflow；放到别处时同时改 systemd 服务的 ReadWritePaths
STORAGE_DIR=/var/lib/quoteflow/storage

# 发信：公司邮件服务的 SMTP；MAIL_FROM 要与 SMTP 账号匹配
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASS=CHANGE_ME
MAIL_FROM="QuoteFlow <noreply@example.com>"

# 锁定报价 Excel 的签名密钥（至少 8 位）与工作表保护密码。上线后不要更换：换了以后之前下载的报价 Excel 都不能再导入
EXCEL_SIGNING_SECRET=CHANGE_ME
EXCEL_SHEET_PASSWORD=CHANGE_ME

# 定时任务（发邮件、截止、催报、清理）在 API 进程内运行，只能有一个 API 实例
JOBS_ENABLED=true
LOG_LEVEL=log
