# 复制成 docker/staging.env 后修改（staging.env 不提交）。启动时用 --env-file docker/staging.env
POSTGRES_PASSWORD=change-me-staging-db
# 锁定报价 Excel 的签名密钥（至少 8 位）与工作表保护密码
EXCEL_SIGNING_SECRET=change-me-staging-excel-secret
EXCEL_SHEET_PASSWORD=change-me-sheet
# 邮件里的链接前缀：本机演示用默认值；配置了对外访问入口后改成对外地址
APP_BASE_URL=http://127.0.0.1:18080
# 默认发到本环境自带的 Mailpit（http://127.0.0.1:18026）；接真实 SMTP 时改这几项
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QuoteFlow <noreply@quoteflow.local>
COOKIE_SECURE=false
